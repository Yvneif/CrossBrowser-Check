{
  "name": "crossbrowser-check",
  "version": "0.1.0",
  "description": "Cross-browser visual regression tool: captures a URL in Chromium, Firefox and WebKit across configurable viewports, pixel-diffs against a stored baseline, and generates a side-by-side HTML gallery report.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yvneif/CrossBrowser-Check.git"
  },
  "type": "module",
  "license": "MIT",
  "author": "Kenneth",
  "bin": {
    "vdiff": "src/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "vitest": "^5.0.0"
  }
}
